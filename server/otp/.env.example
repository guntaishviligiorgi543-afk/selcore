# Blank server-only settings. Use a protected secret manager; never fill this tracked file.
# Private Auth must be unreachable from public clients, including its old managed URL.
SELCORE_PRIVATE_SUPABASE_ORIGIN=
SELCORE_PRIVATE_PUBLISHABLE_KEY=
SELCORE_PRIVATE_ADMIN_KEY=
# Dedicated non-superuser login inheriting selcore_otp_worker; remote TLS is verified.
SELCORE_OTP_DATABASE_URL=
# Independent random keys, base64 encoded. HMAC >=32 bytes; encryption exactly32 bytes.
SELCORE_OTP_HMAC_KEY=
SELCORE_OTP_ENCRYPTION_KEY=
# Existing Resend provider, verified sender domain, server-only credential.
SELCORE_SMTP_USER=resend
SELCORE_SMTP_PASSWORD=
SELCORE_SMTP_FROM=
SELCORE_SMTP_PORT=465
# This build's runtime.cjs source gate is disabled and cannot be enabled by env.
# Canonical HTTPS SAME origin as the frontend; route /api/auth only after approval.
SELCORE_GATEWAY_ORIGIN=
# Railway supplies PORT; it takes precedence over this localhost fallback.
SELCORE_GATEWAY_PORT=8081
# True only for an isolated localhost test stack, never for production.
SELCORE_LOCAL_HTTP=false
